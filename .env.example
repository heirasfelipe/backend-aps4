# ==============================================================================
# Configurações de Segurança e Autenticação JWT — APS 4
# Copie este arquivo para ".env" e defina valores reais e seguros antes de rodar.
# NUNCA publique o arquivo ".env" nem chaves secretas reais no GitHub!
# ==============================================================================

# Chave secreta usada na assinatura dos tokens JWT (gere com: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=substitua-por-uma-chave-secreta-forte-e-aleatoria

# Algoritmo de assinatura JWT (padrão: HS256)
JWT_ALGORITHM=HS256

# Tempo de expiração do token de acesso em minutos (padrão: 60)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# (Opcional) Credenciais para criação automática do administrador inicial no startup ou via criar_admin.py
ADMIN_NOME=Administrador do Sistema
ADMIN_EMAIL=admin@instituicao.edu.br
ADMIN_SENHA=altere-para-uma-senha-forte

